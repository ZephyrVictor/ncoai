# Shared ports and model names. Override ports that are already in use.
POSTGRES_USER=ncoai
POSTGRES_DB=ncoai_chat
POSTGRES_PORT=55432
REDIS_PORT=6379
NGINX_PORT=8088
NGINX_SERVER_NAME=_
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
LOKI_PORT=3101
ADMIN_MONITORING_PROMETHEUS_URL=http://127.0.0.1:9091

VLLM_HOST=127.0.0.1
VLLM_PORT=12233
SERVED_MODEL_NAME=qwen35_27b
CHAINLIT_DEFAULT_MODEL=qwen35_27b_no_think
CHAINLIT_THINKING_MODEL=qwen35_27b_think
CHAINLIT_ENABLE_THINKING=1
MAX_MODEL_LEN=4096
CAPS_ENABLED=0

# Dual-host Active-Active vLLM least_conn gateway (recommended for 200-user concurrency)
VLLM_LB_ENABLED=0
VLLM_LB_PORT=12230
VLLM_LB_ORIGIN=
VLLM_LB_UPSTREAM_ORIGINS=
VLLM_REMOTE_ORIGINS=
VLLM_API_KEY=
VLLM_REASONING_PARSER=qwen3
DISABLE_CUSTOM_ALL_REDUCE=1
CHAINLIT_LITELLM_MAX_CONCURRENT_REQUESTS=320
VLLM_PRIMARY_REQUEST_TIMEOUT_SECONDS=60
