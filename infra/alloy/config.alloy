discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "docker" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    replacement   = "$1"
    target_label  = "container"
  }

  rule {
    source_labels = ["container"]
    regex         = "ncoai-.*"
    action        = "keep"
  }

  rule {
    source_labels = ["container"]
    regex         = "ncoai-(.*)"
    replacement   = "$1"
    target_label  = "service"
  }

  rule {
    target_label = "source"
    replacement  = "docker"
  }

  rule {
    target_label = "instance"
    replacement  = "docker"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker.output
  labels     = {}
  forward_to = [loki.process.docker.receiver]
}

loki.process "docker" {
  stage.regex {
    expression = "(?i)\\b(?P<level>debug|info|warn|warning|error|fatal|critical)\\b"
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [loki.write.local.receiver]
}

loki.source.file "host_services" {
  targets = [{
    __path__ = "/var/log/ncoai-host/*.log",
    job      = "host-services",
    source   = "host",
    instance = "host",
  }]

  file_match {
    enabled = true
  }

  forward_to = [loki.process.host_services.receiver]
}

loki.process "host_services" {
  stage.regex {
    source     = "filename"
    expression = "^/var/log/ncoai-host/(?P<service>[^/]+)\\.log$"
  }

  stage.labels {
    values = { service = "" }
  }

  stage.regex {
    expression = "(?i)\\b(?P<level>debug|info|warn|warning|error|fatal|critical)\\b"
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
