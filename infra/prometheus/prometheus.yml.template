global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node-exporter
    static_configs:
      - targets: ["node-exporter:9100"]

  - job_name: postgres-exporter
    static_configs:
      - targets: ["postgres-exporter:9187"]

  - job_name: redis-exporter
    static_configs:
      - targets: ["redis-exporter:9121"]

  - job_name: litellm-metrics
    metrics_path: /metrics
    static_configs:
      - targets: ["host.docker.internal:${LITELLM_PORT}"]

  - job_name: vllm-metrics
    metrics_path: /metrics
    static_configs:
      - targets: ["host.docker.internal:${VLLM_PORT}"]

  - job_name: admin-metrics
    metrics_path: ${ADMIN_APP_ROOT_PATH}/metrics
    static_configs:
      - targets: ["host.docker.internal:${ADMIN_APP_PORT}"]

  - job_name: chainlit-metrics
    metrics_path: ${CHAINLIT_ROOT_PATH}/metrics
    static_configs:
      - targets: ["host.docker.internal:${CHAINLIT_PORT}"]

  - job_name: host-service-health
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - http://127.0.0.1:${NGINX_PORT}/
          - http://127.0.0.1:${CHAINLIT_PORT}${CHAINLIT_ROOT_PATH}/health
          - http://127.0.0.1:${ADMIN_APP_PORT}${ADMIN_APP_ROOT_PATH}/healthz
          - http://127.0.0.1:${LITELLM_PORT}/test
          - http://127.0.0.1:${VLLM_PORT}/metrics
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: host.docker.internal:9115

__CAPS_TCP_JOB_BLOCK__
