events {
  worker_connections 4096;
}

http {
  map $http_cookie $chainlit_sticky_key {
    "~*(?:^|;\\s*)X-Chainlit-Session-id=([^;]+)" $1;
    default "$remote_addr|$http_user_agent";
  }

  upstream chainlit_upstream {
    hash $chainlit_sticky_key consistent;
${CHAINLIT_UPSTREAM_SERVERS}
  }

  upstream admin_upstream {
    server 127.0.0.1:${ADMIN_APP_PORT};
  }

  upstream grafana_upstream {
    server 127.0.0.1:${GRAFANA_PORT};
  }

  server {
    listen ${NGINX_PORT};
    server_name _;
    proxy_redirect ~^http://[^/]+(/.*)$ $scheme://$http_host$1;

    location = / {
      return 302 /chat;
    }

    location = /chat {
      proxy_pass http://chainlit_upstream/chat;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
    }

    location /chat/ {
      proxy_pass http://chainlit_upstream/chat/;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_buffering off;
      proxy_read_timeout 3600s;
    }

    location = /admin {
      proxy_pass http://admin_upstream/admin;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
    }

    location /admin/ {
      proxy_pass http://admin_upstream/admin/;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
    }

    location = /grafana {
      return 302 /grafana/;
    }

    location /grafana/ {
      proxy_pass http://grafana_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_buffering off;
      proxy_read_timeout 3600s;
    }

    location /ws/socket.io {
      proxy_pass http://chainlit_upstream/chat/ws/socket.io;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_buffering off;
      proxy_read_timeout 3600s;
    }
  }

  server {
    listen ${NGINX_PUBLIC_HTTP_PORT};
    server_name ${NGINX_SERVER_NAME};
    proxy_redirect ~^http://[^/]+(/.*)$ $scheme://$http_host$1;

    location ^~ /.well-known/acme-challenge/ {
      root ${NGINX_ACME_WEBROOT};
      default_type "text/plain";
      try_files $uri =404;
    }

    location = / {
      return 302 /chat;
    }

    location = /chat {
      proxy_pass http://chainlit_upstream/chat;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
    }

    location /chat/ {
      proxy_pass http://chainlit_upstream/chat/;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_buffering off;
      proxy_read_timeout 3600s;
    }

    location = /admin {
      proxy_pass http://admin_upstream/admin;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
    }

    location /admin/ {
      proxy_pass http://admin_upstream/admin/;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
    }

    location = /grafana {
      return 302 /grafana/;
    }

    location /grafana/ {
      proxy_pass http://grafana_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_buffering off;
      proxy_read_timeout 3600s;
    }

    location /ws/socket.io {
      proxy_pass http://chainlit_upstream/chat/ws/socket.io;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_buffering off;
      proxy_read_timeout 3600s;
    }
  }

  include /etc/nginx/conf.d/*.conf;
}
